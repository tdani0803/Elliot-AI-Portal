# --- Frontend (safe to expose; baked into the build) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to "true" to preview the dashboard with sample data and no Supabase project.
VITE_DEMO_MODE=false

# --- Server only (Netlify env vars / local scripts). NEVER prefix with VITE_ ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret Vapi sends in the X-Vapi-Secret header (set as the server "secret" in Vapi).
VAPI_WEBHOOK_SECRET=make-this-long-and-random
# Where invite / password emails should send people back to.
PORTAL_URL=https://portal.elliotai.com.au
